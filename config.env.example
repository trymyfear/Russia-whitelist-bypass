# ==============================================================================
# Whitelist Bypass Configuration
# Copy this file to 'config.env' and customize it for your environment.
# ==============================================================================

# --- Российский релей (Yandex Cloud, VK Cloud, Selectel и т.д.) ---
RUSSIAN_IP=1.2.3.4
RUSSIAN_LOGIN=whitelist
RUSSIAN_PORT=443
RUSSIAN_SSH_PORT=22

# REALITY маскировка для релея (домен из пула белого списка мобильных операторов РФ)
RELAY_SNI=ya.ru
RELAY_TARGET=ya.ru:443

# Ключи REALITY для релея (скрипт deploy-relay.sh может сгенерировать их автоматически)
# RELAY_REALITY_PRIVATE_KEY=
# RELAY_REALITY_PUBLIC_KEY=
# RELAY_SHORT_ID=

# --- Зарубежный сервер (Германия, Нидерланды, Финляндия и т.д.) ---
FOREIGN_IP=5.6.7.8
FOREIGN_LOGIN=root
FOREIGN_PORT=443
FOREIGN_SSH_PORT=22

# REALITY маскировка для зарубежного выхода
FOREIGN_SNI=www.yahoo.com
FOREIGN_TARGET=www.yahoo.com:443

# Ключи REALITY для зарубежного сервера (скрипт deploy-foreign.sh может сгенерировать их автоматически)
# FOREIGN_REALITY_PRIVATE_KEY=
# FOREIGN_PUBLIC_KEY=
# FOREIGN_SHORT_ID=

# Ключ связи между серверами (Межсерверный UUID)
# HOP_UUID=

# --- SSH настройки для локальных скриптов ---
SSH_KEY_PATH=.secrets/project_ed25519
KNOWN_HOSTS_PATH=.secrets/known_hosts
